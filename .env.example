OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=high

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# Optional: import from Google Photos. Create an OAuth "Web application" client
# and add http://localhost:5173/api/import/google-photos/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_PHOTOS_REDIRECT_URI=http://localhost:5173/api/import/google-photos/callback
